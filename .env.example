## Example .env for text2Cypher

# Choose provider: openai, gemini, or ollama
MODEL_PROVIDER=ollama

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-nano

# Google Gemini (single key)
# GEMINI_API_KEY=AIza...

# Google Gemini (multiple keys - JSON array or comma/newline separated)
# GEMINI_API_KEYS=["key1","key2"]

# Ollama (LLM server)
OLLAMA_HOST=http://161.153.217.110:11434
OLLAMA_MODEL=glm-5.3-flash:latest

# Same LLM endpoint under every other common name (aliases — the code
# currently reads OLLAMA_HOST; uncomment whichever matches your setup):
# LLM_URL=http://161.153.217.110:11434
# LLM_BASE_URL=http://161.153.217.110:11434
# OLLAMA_BASE_URL=http://161.153.217.110:11434
# OPENAI_BASE_URL=http://161.153.217.110:11434/v1
# OPENAI_API_BASE=http://161.153.217.110:11434/v1

# Neo4j connection
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DB=cti

# Langfuse (optional)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://us.cloud.langfuse.com

# Security note: keep this file out of version control or use a .gitignore entry
